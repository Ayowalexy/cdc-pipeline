# Local-only, synthetic configuration. Copy to .env (`cp .env.example .env`). No real credentials.

# PostgreSQL (source of truth)
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_local_only
POSTGRES_DB=orders
POSTGRES_HOST_PORT=55432

# pgAdmin (desktop mode, no login; the server password above is asked on first connect)
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_local_only

# Kafka (KRaft, single node). Host listener for scripts/tests; containers use kafka:9092.
KAFKA_HOST_PORT=29092
KAFKA_ORDERS_TOPIC=cdc.public.orders
KAFKA_DLQ_TOPIC=cdc.public.orders.dlq
KAFKA_GROUP_ID=order-projection

# Kafka Connect / Debezium REST
CONNECT_HOST_PORT=8083

# Elasticsearch / Kibana (security disabled: local exercise only)
ES_HOST_PORT=9200
KIBANA_HOST_PORT=5601
ES_ORDERS_INDEX=orders

# Applications
ORDER_SERVICE_HOST_PORT=3100
CDC_CONSUMER_HOST_PORT=3101
