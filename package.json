{
  "name": "cdc-order-sync",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL -> Debezium -> Kafka -> NestJS -> Elasticsearch order projection (engineering exercise)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:order-service": "node dist/apps/order-service/src/main.js",
    "start:cdc-consumer": "node dist/apps/cdc-consumer/src/main.js",
    "connector:register": "bash scripts/register-connector.sh",
    "seed": "tsx scripts/seed-orders.ts",
    "reproduce:stale": "tsx scripts/reproduce-stale-update.ts",
    "replay:event": "tsx scripts/replay-event.ts",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "reset:local": "bash scripts/reset-local-env.sh",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand"
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.15.3",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "kafkajs": "2.2.4",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
